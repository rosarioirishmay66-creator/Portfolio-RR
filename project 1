<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TapSeafood Shop Platform — Live Demo</title>
  <style>
    :root {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --accent: #db2777;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --radius: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding-bottom: 60px; }

    /* Top Bar */
    .demo-bar {
      background: var(--text);
      color: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }
    .demo-bar .badge { background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 4px; font-weight: bold; }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-size: 1.4rem; font-weight: 800; color: var(--primary); text-decoration: none; }
    .brand span { color: var(--accent); }

    .nav-tabs { display: flex; gap: 8px; }
    .nav-tab {
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: transparent;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .nav-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    .cart-btn {
      position: relative;
      background: #f1f5f9;
      border: 1px solid var(--border);
      padding: 8px 16px;
      border-radius: 20px;
      cursor: pointer;
      font-weight: 600;
    }
    .cart-count {
      position: absolute;
      top: -5px;
      right: -5px;
      background: var(--accent);
      color: #fff;
      font-size: 0.75rem;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Main Container */
    .container { max-width: 1100px; margin: 24px auto; padding: 0 16px; }

    /* Views */
    .view-section { display: none; }
    .view-section.active { display: block; }

    /* Customer View Controls */
    .controls-bar {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .search-input {
      flex: 1;
      min-width: 200px;
      padding: 10px 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
      outline: none;
    }
    .cat-btn {
      padding: 10px 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      cursor: pointer;
    }
    .cat-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* Product Grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
    }
    .product-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .product-card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); }
    .product-img-placeholder {
      height: 140px;
      background: #f0f9ff;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.5rem;
      margin-bottom: 12px;
    }
    .product-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }
    .product-category { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; margin-bottom: 8px; }
    .product-price { font-size: 1.2rem; font-weight: 800; color: var(--primary); margin-bottom: 12px; }
    .add-btn {
      width: 100%;
      padding: 10px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.2s;
    }
    .add-btn:hover { background: var(--primary-hover); }

    /* Cart Drawer Overlay */
    .cart-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      display: none;
      z-index: 200;
    }
    .cart-drawer {
      position: fixed;
      top: 0; right: -400px; bottom: 0;
      width: 100%;
      max-width: 400px;
      background: var(--surface);
      z-index: 201;
      transition: right 0.3s ease;
      display: flex;
      flex-direction: column;
      padding: 20px;
    }
    .cart-drawer.open { right: 0; }

    .cart-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
    .cart-items { flex: 1; overflow-y: auto; margin: 16px 0; }
    .cart-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; }
    .cart-footer { border-top: 1px solid var(--border); padding-top: 12px; }
    .checkout-btn { width: 100%; padding: 12px; background: var(--accent); color: #fff; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; margin-top: 12px; }

    /* Vendor Dashboard Styles */
    .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: var(--surface); padding: 16px; border-radius: var(--radius); border: 1px solid var(--border); }
    .stat-card h4 { font-size: 0.85rem; color: var(--muted); }
    .stat-card p { font-size: 1.5rem; font-weight: 800; color: var(--primary); margin-top: 4px; }

    .inventory-table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
    .inventory-table th, .inventory-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); }
    .inventory-table th { background: #f8fafc; font-size: 0.85rem; color: var(--muted); }

    /* Receipt Modal */
    .receipt-modal {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      background: #fff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
      display: none;
      z-index: 300;
      width: 90%;
      max-width: 400px;
    }
  </style>
</head>
<body>

  <div class="demo-bar">
    <div><strong>TapSeafood</strong> — Live Interactive Demo</div>
    <div><span class="badge">BSIT PORTFOLIO PROJECT</span></div>
  </div>

  <header>
    <div class="header-container">
      <a href="#" class="brand">TapSeafood<span>.</span></a>
      <div class="nav-tabs">
        <button class="nav-tab active" onclick="switchView('store')">Storefront View</button>
        <button class="nav-tab" onclick="switchView('vendor')">Vendor Admin Portal</button>
      </div>
      <button class="cart-btn" onclick="toggleCart()">
        🛒 Cart <span class="cart-count" id="cartCount">0</span>
      </button>
    </div>
  </header>

  <div class="container">
    <!-- STOREFRONT VIEW -->
    <section id="storeView" class="view-section active">
      <div class="controls-bar">
        <input type="text" id="searchInput" class="search-input" placeholder="Search fresh seafood..." onkeyup="filterProducts()">
        <button class="cat-btn active" onclick="filterCategory('All', this)">All Catch</button>
        <button class="cat-btn" onclick="filterCategory('Fish', this)">Fish</button>
        <button class="cat-btn" onclick="filterCategory('Shellfish', this)">Shellfish</button>
        <button class="cat-btn" onclick="filterCategory('Crustacean', this)">Crustaceans</button>
      </div>

      <div class="product-grid" id="productGrid"></div>
    </section>

    <!-- VENDOR ADMIN VIEW -->
    <section id="vendorView" class="view-section">
      <div class="dash-stats">
        <div class="stat-card">
          <h4>Total Daily Sales</h4>
          <p id="totalSales">₱2,450.00</p>
        </div>
        <div class="stat-card">
          <h4>Completed Orders</h4>
          <p id="totalOrders">5</p>
        </div>
        <div class="stat-card">
          <h4>Active Inventory Items</h4>
          <p id="totalInventory">6</p>
        </div>
      </div>

      <h3 style="margin-bottom: 12px;">Stock & Pricing Management</h3>
      <table class="inventory-table">
        <thead>
          <tr>
            <th>Item Name</th>
            <th>Category</th>
            <th>Price (per kg)</th>
            <th>Stock Level</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="vendorTable"></tbody>
      </table>
    </section>
  </div>

  <!-- CART DRAWER -->
  <div class="cart-overlay" id="cartOverlay" onclick="toggleCart()"></div>
  <div class="cart-drawer" id="cartDrawer">
    <div class="cart-header">
      <h3>Your Fresh Order</h3>
      <button onclick="toggleCart()" style="background:none; border:none; font-size:1.2rem; cursor:pointer;">✕</button>
    </div>
    <div class="cart-items" id="cartItems">
      <p style="text-align: center; color: var(--muted); margin-top: 40px;">Your cart is empty.</p>
    </div>
    <div class="cart-footer">
      <div style="display:flex; justify-content:space-between; font-weight:700; font-size:1.1rem; margin-bottom:12px;">
        <span>Total:</span>
        <span id="cartTotal">₱0.00</span>
      </div>
      <button class="checkout-btn" onclick="processCheckout()">Checkout Order ↗</button>
    </div>
  </div>

  <!-- RECEIPT MODAL -->
  <div class="receipt-modal" id="receiptModal">
    <h3 style="text-align:center; color: var(--primary);">TapSeafood</h3>
    <p style="text-align:center; font-size: 0.8rem; color: var(--muted);">Order Confirmation & Invoice</p>
    <hr style="margin: 12px 0; border: none; border-top: 1px dashed var(--border);">
    <div id="receiptContent" style="font-size:0.9rem;"></div>
    <hr style="margin: 12px 0; border: none; border-top: 1px dashed var(--border);">
    <button onclick="closeReceipt()" style="width:100%; padding:10px; background:var(--primary); color:#fff; border:none; border-radius:6px; font-weight:600; cursor:pointer;">Close Invoice</button>
  </div>

  <script>
    // Initial Products Data
    let products = [
      { id: 1, name: "Bangus (Milkfish)", category: "Fish", price: 220, stock: 15, icon: "🐟" },
      { id: 2, name: "Tilapia", category: "Fish", price: 160, stock: 20, icon: "🐠" },
      { id: 3, name: "Suahe (Shrimp)", category: "Crustacean", price: 480, stock: 10, icon: "🦐" },
      { id: 4, name: "Alimango (Mud Crab)", category: "Crustacean", price: 750, stock: 6, icon: "🦀" },
      { id: 5, name: "Tahong (Mussels)", category: "Shellfish", price: 120, stock: 25, icon: "🦪" },
      { id: 6, name: "Squid (Pusit)", category: "Shellfish", price: 380, stock: 8, icon: "🦑" }
    ];

    let cart = [];
    let salesTotal = 2450;
    let orderCount = 5;

    // Render Storefront
    function renderProducts(itemsToRender = products) {
      const grid = document.getElementById("productGrid");
      grid.innerHTML = "";
      itemsToRender.forEach(p => {
        grid.innerHTML += `
          <div class="product-card">
            <div class="product-img-placeholder">${p.icon}</div>
            <div>
              <div class="product-category">${p.category}</div>
              <div class="product-title">${p.name}</div>
              <div class="product-price">₱${p.price}.00 / kg</div>
            </div>
            <button class="add-btn" onclick="addToCart(${p.id})">Add to Cart</button>
          </div>
        `;
      });
    }

    // Render Vendor Table
    function renderVendorTable() {
      const tbody = document.getElementById("vendorTable");
      tbody.innerHTML = "";
      products.forEach(p => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${p.icon} ${p.name}</strong></td>
            <td>${p.category}</td>
            <td>₱${p.price}.00</td>
            <td>${p.stock} kg</td>
            <td><button onclick="restock(${p.id})" style="padding: 4px 8px; cursor:pointer;">+ Restock 5kg</button></td>
          </tr>
        `;
      });
      document.getElementById("totalInventory").innerText = products.length;
    }

    // Cart Handlers
    function addToCart(id) {
      const item = products.find(p => p.id === id);
      const existing = cart.find(c => c.id === id);
      if(existing) {
        existing.qty++;
      } else {
        cart.push({ ...item, qty: 1 });
      }
      updateCartUI();
    }

    function updateCartUI() {
      const cartItems = document.getElementById("cartItems");
      const cartCount = document.getElementById("cartCount");
      const cartTotal = document.getElementById("cartTotal");

      cartCount.innerText = cart.reduce((sum, item) => sum + item.qty, 0);

      if(cart.length === 0) {
        cartItems.innerHTML = `<p style="text-align: center; color: var(--muted); margin-top: 40px;">Your cart is empty.</p>`;
        cartTotal.innerText = "₱0.00";
        return;
      }

      cartItems.innerHTML = "";
      let total = 0;
      cart.forEach(item => {
        const itemTotal = item.price * item.qty;
        total += itemTotal;
        cartItems.innerHTML += `
          <div class="cart-item">
            <div>
              <strong>${item.name}</strong>
              <div style="font-size: 0.8rem; color: var(--muted);">₱${item.price} x ${item.qty}</div>
            </div>
            <div>
              <strong>₱${itemTotal}</strong>
            </div>
          </div>
        `;
      });

      cartTotal.innerText = `₱${total}.00`;
    }

    function toggleCart() {
      const drawer = document.getElementById("cartDrawer");
      const overlay = document.getElementById("cartOverlay");
      drawer.classList.toggle("open");
      overlay.style.display = drawer.classList.contains("open") ? "block" : "none";
    }

    // Checkout
    function processCheckout() {
      if(cart.length === 0) return alert("Your cart is empty!");

      const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      salesTotal += total;
      orderCount++;

      document.getElementById("totalSales").innerText = `₱${salesTotal.toFixed(2)}`;
      document.getElementById("totalOrders").innerText = orderCount;

      let summaryHTML = `<p><strong>Order #:</strong> TS-${Math.floor(1000 + Math.random() * 9000)}</p><br>`;
      cart.forEach(i => {
        summaryHTML += `<div style="display:flex; justify-space-between;"><span>${i.name} (${i.qty}kg)</span> <span>₱${i.price * i.qty}</span></div>`;
      });
      summaryHTML += `<br><div style="display:flex; justify-space-between; font-weight:bold;"><span>Grand Total:</span> <span>₱${total}.00</span></div>`;

      document.getElementById("receiptContent").innerHTML = summaryHTML;
      document.getElementById("receiptModal").style.display = "block";

      cart = [];
      updateCartUI();
      toggleCart();
    }

    function closeReceipt() {
      document.getElementById("receiptModal").style.display = "none";
    }

    // View Switching
    function switchView(view) {
      document.querySelectorAll(".nav-tab").forEach(tab => tab.classList.remove("active"));
      document.querySelectorAll(".view-section").forEach(sec => sec.classList.remove("active"));

      if(view === 'store') {
        event.target.classList.add("active");
        document.getElementById("storeView").classList.add("active");
      } else {
        event.target.classList.add("active");
        document.getElementById("vendorView").classList.add("active");
        renderVendorTable();
      }
    }

    // Filters
    function filterProducts() {
      const query = document.getElementById("searchInput").value.toLowerCase();
      const filtered = products.filter(p => p.name.toLowerCase().includes(query));
      renderProducts(filtered);
    }

    function filterCategory(cat, btn) {
      document.querySelectorAll(".cat-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      if(cat === 'All') renderProducts(products);
      else renderProducts(products.filter(p => p.category === cat));
    }

    function restock(id) {
      const item = products.find(p => p.id === id);
      item.stock += 5;
      renderVendorTable();
    }

    // Init
    renderProducts();
  </script>
</body>
</html>
