<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Water Dispenser — Live Demo</title>
  <style>
    :root {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --accent: #db2777;
      --cold: #0284c7;
      --hot: #ef4444;
      --ambient: #10b981;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --radius: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding-bottom: 60px; }

    /* Top Bar */
    .demo-bar {
      background: var(--text);
      color: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }
    .demo-bar .badge { background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 4px; font-weight: bold; }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-size: 1.4rem; font-weight: 800; color: var(--primary); text-decoration: none; }
    .brand span { color: var(--accent); }

    .nav-tabs { display: flex; gap: 8px; }
    .nav-tab {
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: transparent;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .nav-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* Main Container */
    .container { max-width: 1100px; margin: 24px auto; padding: 0 16px; }

    /* Views */
    .view-section { display: none; }
    .view-section.active { display: block; }

    /* Dispenser Grid */
    .dispenser-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) {
      .dispenser-layout { grid-template-columns: 1fr; }
    }

    /* Water Jug Visual */
    .jug-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      text-align: center;
    }
    .jug-container {
      width: 160px;
      height: 260px;
      border: 4px solid #cbd5e1;
      border-radius: 20px 20px 10px 10px;
      margin: 20px auto;
      position: relative;
      overflow: hidden;
      background: #f1f5f9;
    }
    .water-fill {
      position: absolute;
      bottom: 0;
      width: 100%;
      height: 80%;
      background: linear-gradient(180deg, #38bdf8 0%, #0284c7 100%);
      transition: height 0.5s ease;
    }
    .water-level-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-weight: 800;
      font-size: 1.5rem;
      color: #fff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
      z-index: 10;
    }

    /* Control Panel */
    .controls-card {
      background: var(--surface);
      border: 1px solid var(--border);
