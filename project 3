<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grand Horizon Hotel — Online Booking System</title>
  <style>
    :root {
      --primary: #0d9488;
      --primary-hover: #0f766e;
      --accent: #f43f5e;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --radius: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding-bottom: 60px; }

    /* Top Bar */
    .demo-bar {
      background: var(--text);
      color: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }
    .demo-bar .badge { background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 4px; font-weight: bold; }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-size: 1.4rem; font-weight: 800; color: var(--primary); text-decoration: none; }
    .brand span { color: var(--accent); }

    .nav-tabs { display: flex; gap: 8px; }
    .nav-tab {
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: transparent;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .nav-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* Main Container */
    .container { max-width: 1100px; margin: 24px auto; padding: 0 16px; }

    /* Views */
    .view-section { display: none; }
    .view-section.active { display: block; }

    /* Search & Filter Bar */
    .filter-bar {
      background: var(--surface);
      padding: 20px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      align-items: flex-end;
      margin-bottom: 24px;
    }
    .filter-group { flex: 1; min-width: 160px; }
